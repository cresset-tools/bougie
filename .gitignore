/target

# Local cache for fixture-generation deps (e.g. pinned composer.phar
# pulled in by scripts/generate-autoload-fixtures.sh).
/.cache

# Visual Studio workspace state (per-user; not project config).
.vs/

# Claude Code local state (worktrees for background agents, etc.).
/.claude/

# VitePress site (website/).
/website/node_modules
/website/.vitepress/cache
/website/.vitepress/dist

# Erlang crash dumps: a broker that dies in prelaunch writes one into
# whatever directory the test ran from (crates/bougie/).
erl_crash.dump
